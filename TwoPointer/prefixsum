// prefix sum another variant
-> Longest subarray with sum greater than or equal to 0:
  public static int longestNonNegativeSubarray() {

    int[] arr = {-1, 1, 1, -1, 2};
    int n = arr.length;

    // Step 1: Prefix sum
    int[] prefix = new int[n + 1];
    for (int i = 1; i <= n; i++) {
        prefix[i] = prefix[i - 1] + arr[i - 1];
    }

    // Step 2: Monotonic decreasing prefix indices
    ArrayList<Integer> minPrefInd = new ArrayList<>();
    minPrefInd.add(0); 

    int last = prefix[0];
    for (int i = 1; i <= n; i++) {
        if (prefix[i] < last) {
            minPrefInd.add(i);
            last = prefix[i];
        }
    }

    // Step 3: Scan from right
    int ans = 0;
    int j = minPrefInd.size() - 1;

    for (int r = n; r >= 0; r--) {
        while (j >= 0 && prefix[minPrefInd.get(j)] <= prefix[r]) {
            ans = Math.max(ans, r - minPrefInd.get(j));
            j--;
        }
    }

    return ans;
}
